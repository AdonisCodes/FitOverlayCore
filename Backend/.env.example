# Copy to `.env.local` for local development (docker compose loads it automatically).

# Postgres connection with read & write access
PRIMARY_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?tlsmode=disable
# Read-only replica (point at the primary locally)
REGIONAL_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?tlsmode=disable

# HMAC secret used to sign JWT access/refresh tokens
JWT_ENCRYPTION_SECRET=change-me

# Seconds a user must wait between verification code requests
AUTHENTICATION_CODE_DISTANCE=60

# Shared secret for test-only controllers (X-Tests-Controller-Key header)
TEST_CONTROLLERS_KEY=change-me

# local | sandbox | staging | production
ENVIRONMENT=local
LOG_LEVEL=debug

# Payment provider webhook secrets (used once webhook verification is implemented)
# STRIPE_WEBHOOK_SECRET=
# APP_STORE_SHARED_SECRET=
