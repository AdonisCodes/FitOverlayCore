# Copy to `.env.local` for local development (docker compose loads it automatically).

# --- Core -------------------------------------------------------------------
# Postgres connection with read & write access
PRIMARY_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?tlsmode=disable
# Read-only replica (point at the primary locally)
REGIONAL_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?tlsmode=disable

# HMAC secret used to sign JWT access/refresh tokens
JWT_ENCRYPTION_SECRET=change-me

# Seconds a user must wait between verification code requests
AUTHENTICATION_CODE_DISTANCE=60

# Shared secret for test-only controllers (X-Tests-Controller-Key header)
TEST_CONTROLLERS_KEY=change-me

# local | sandbox | staging | production
ENVIRONMENT=local
LOG_LEVEL=debug
BACKEND_URL=http://127.0.0.1:8080

# --- Temporal ---------------------------------------------------------------
# Hostname of the Temporal server (docker compose runs one locally)
TEMPORAL_SERVER_HOSTNAME=127.0.0.1

# --- Messaging / alerts -----------------------------------------------------
# Discord webhook for app events and alerts
DISCORD_APP_EVENTS_URL=

# --- AWS / SNS (transactional SMS) ------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- OpenAI (profile generation, chat completion) ---------------------------
OPENAI_API_KEY=

# --- Tigris (S3-compatible media storage; localstack locally) ---------------
TIGRIS_ACCESS_KEY_ID=
TIGRIS_ACCESS_KEY_SECRET=
TIGRIS_MEDIA_BUCKET_NAME=
TIGRIS_BASE_URL=

# --- Twitter integration ----------------------------------------------------
TWITTER_API_APP_KEY=
TWITTER_API_APP_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_SECRET_TOKEN=
# Seed/test tokens used by the integration test suite
TEST_TWITTER_OAUTH_TOKEN_ID=
TEST_TWITTER_USER_TOKEN_ID=
SEED_TWITTER_OAUTH_TOKEN=
SEED_TWITTER_OAUTH_TOKEN_SECRET=
SEED_TWITTER_USER_ACCESS_TOKEN=
SEED_TWITTER_USER_ACCESS_TOKEN_SECRET=
SEED_TWITTER_USER_ACCESS_TOKEN_VERIFIER=

# --- Web core / scraping ----------------------------------------------------
FITOVERLAY_WEB_CORE_API_BASE_URL=

# --- Observability ----------------------------------------------------------
PROMETHEUS_PORT=6834
PROMETHEUS_BASE_URL=
FLY_METRICS_TOKEN=

# --- Payments (licensing webhooks; verification TODO) ------------------------
# STRIPE_WEBHOOK_SECRET=
# APP_STORE_SHARED_SECRET=
