{
  "name": "fitoverlaycore",
  "version": "0.1.0",
  "description": "Main infrastructure & core of FitOverlay",
  "scripts": {
    "build:all": "npx npm-run-all --sequential build:kit build:backend",
    "build:backend": "cd Backend && swift build",
    "build:kit": "cd FitOverlayKit && swift build",
    "test:backend": "cd Backend && swift test",
    "test:kit": "cd FitOverlayKit && swift test",
    "format": "swiftformat .",
    "lint": "swiftlint . --config=.swiftlint.yml",
    "compose": "cd Backend && docker compose",
    "compose:up": "npm run compose -- up -d",
    "compose:build": "npm run compose -- build",
    "compose:build-and-up": "npx npm-run-all --sequential compose:build compose:up",
    "compose:down": "npm run compose -- down",
    "compose:ps": "npm run compose -- ps -a",
    "install:swiftlint": "brew install swiftlint",
    "install:swiftformat": "brew install swiftformat",
    "install:all": "npx npm-run-all --sequential install:swiftlint install:swiftformat",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "husky": "^8.0.0",
    "npm-run-all": "^4.1.5"
  }
}
